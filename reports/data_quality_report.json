  "cleaning": {
    "rows_in": 1067371,
    "rows_out": 1024819,
    "rows_removed_total": 42552,
    "pct_removed_total": 3.9866,
    "steps": [
      {
        "step": "drop_exact_duplicates",
        "rows_before": 1067371,
        "rows_after": 1055238,
        "rows_removed": 12133,
        "pct_removed": 1.1367,
        "reason": "Identical rows on every column are re-scans of the same line, not two separate sales."
      },
      {
        "step": "drop_missing_key_fields",
        "rows_before": 1055238,
        "rows_after": 1055238,
        "rows_removed": 0,
        "pct_removed": 0.0,
        "reason": "A line with no date or no stock code cannot enter a time series."
      },
      {
        "step": "split_cancellations",
        "rows_before": 1055238,
        "rows_after": 1035805,
        "rows_removed": 19433,
        "pct_removed": 1.8416,
        "reason": "Invoices prefixed 'C' are credit notes. They are removed from the demand series but retained separately as a returns signal."
      },
      {
        "step": "drop_non_product_codes",
        "rows_before": 1035805,
        "rows_after": 1030931,
        "rows_removed": 4874,
        "pct_removed": 0.4706,
        "reason": "Service lines (POST, DOT, M, BANK CHARGES, ADJUST, TEST*) are not stockable items and must not be forecast or reordered. Most frequent removed codes: {'POST': 1893, 'DOT': 1443, 'M': 878, 'C2': 275, 'ADJUST': 36, 'BANK CHARGES': 35, 'DCGS0058': 31, 'GIFT_0001_20': 29, 'GIFT_0001_30': 29, 'DCGSSGIRL': 25, 'DCGSSBOY': 23, 'PADS': 18, 'GIFT_0001_10': 16, 'DCGS0076': 15, 'DCGS0003': 14, 'TEST001': 11, 'GIFT_0001_50': 8, 'GIFT_0001_40': 7, 'DCGS0069': 6, 'B': 6, 'DCGS0004': 5, 'D': 5, 'DCGS0072': 4, 'DCGS0066N': 4, 'AMAZONFEE': 4}"
      },
      {
        "step": "drop_nonpositive_quantity",
        "rows_before": 1030931,
        "rows_after": 1027505,
        "rows_removed": 3426,
        "pct_removed": 0.3323,
        "reason": "Zero or negative quantities on a non-cancellation invoice are adjustments, not demand."
      },
      {
        "step": "drop_nonpositive_price",
        "rows_before": 1027505,
        "rows_after": 1024826,
        "rows_removed": 2679,
        "pct_removed": 0.2607,
        "reason": "Zero-price lines are samples, write-offs or data-entry errors; they would distort the revenue-based SKU ranking."
      },
      {
        "step": "drop_extreme_line_quantity",
        "rows_before": 1024826,
        "rows_after": 1024819,
        "rows_removed": 7,
        "pct_removed": 0.0007,
        "reason": "Single lines above 10000 units are bulk corrections, not retail demand. Removing them stops one row dominating a whole SKU series."
      }
    ]
  },
