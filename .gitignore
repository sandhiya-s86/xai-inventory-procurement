# --- Data: never commit raw or derived datasets ---
data/raw/
data/interim/
data/processed/
data/forecasts/
data/results/
data/simulated/
*.xlsx
*.parquet
*.zip

# Trained models
models/*.joblib
models/*.pkl
models/*.txt

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/

# VS Code: ignore personal state, but DO track the shared workspace config
# (interpreter path, pytest discovery, run tasks) so the project opens and
# runs correctly for anyone who clones it.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Keep directory placeholders
!**/.gitkeep
