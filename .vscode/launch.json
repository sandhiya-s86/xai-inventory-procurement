    },
    {
      "name": "Check PBL-1 completeness", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/scripts/check_pbl1_completeness.py",
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    }
